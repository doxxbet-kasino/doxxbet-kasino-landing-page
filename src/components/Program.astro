---
import { balicky, urovne, vyhody } from '../data/content';
---

<section id="vyhody" class="reference-stage relative overflow-hidden bg-[#0a0b16]">
  <div class="reference-orb reference-orb-a"></div>
  <div class="reference-orb reference-orb-b"></div>
  <div class="relative mx-auto flex min-h-[48rem] max-w-7xl flex-col justify-end px-4 py-20 lg:px-6 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand">DOXXbet Casino Zelená Voda</p>
      <h2 class="mt-5 font-heading text-5xl font-bold italic uppercase leading-[0.9] text-white md:text-7xl">
        Všetko začína<br />
        <span class="heading-accent normal-case">hráčskou kartou.</span>
      </h2>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-white/70">
        Zaregistrujte sa priamo na prevádzke a pri každej návšteve zbierajte body, bonusy aj nové výhody.
      </p>
    </div>

    <div class="mt-16 grid gap-4 md:grid-cols-3">
      {
        vyhody.polozky.map((polozka, index) => (
          <article class="reference-card p-7">
            <span class="font-accent text-4xl font-bold italic text-brand/60">0{index + 1}</span>
            <h3 class="mt-8 font-heading text-2xl font-bold italic text-white">{polozka.titulok}</h3>
            <p class="mt-3 leading-relaxed text-white/65">{polozka.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="urovne" class="border-y border-white/8 bg-[#0d0e1a]">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 lg:grid-cols-[0.9fr_1.1fr] lg:px-6 lg:py-28">
    <div class="flex flex-col justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand">Vaša cesta programom</p>
        <h2 class="mt-5 font-heading text-5xl font-bold italic uppercase leading-[0.9] text-white md:text-6xl">
          Stúpajte vyššie.<br /><span class="heading-accent normal-case">Získavajte viac.</span>
        </h2>
        <p class="mt-7 max-w-md text-lg leading-relaxed text-white/70">{urovne.popis}</p>
      </div>
      <p class="mt-16 font-accent text-6xl font-bold italic text-brand/35 md:text-8xl">DOXXBET</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2">
      {
        urovne.karty.map((karta, index) => (
          <article class="bg-[#141522] p-7">
            <p class="font-accent text-3xl font-bold italic text-brand">0{index + 1}</p>
            <h3 class="mt-5 font-accent text-3xl font-bold italic text-white">{karta.nazov}</h3>
            <p class="mt-2 text-sm font-medium text-brand/80">{urovne.kroky[index].podmienka}</p>
            <p class="mt-6 text-sm leading-relaxed text-white/65"><b class="text-white">Výhody</b><br />{karta.vyhody}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-white/8 bg-[#0a0b16]">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <p class="text-sm font-bold uppercase tracking-[0.24em] text-brand">Welcome bonus</p>
    <div class="mt-5 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <h2 class="max-w-2xl font-heading text-5xl font-bold italic uppercase leading-[0.9] text-white md:text-6xl">
        Vyberte si štartovací<br /><span class="heading-accent normal-case">balík výhod.</span>
      </h2>
      <p class="max-w-sm text-lg leading-relaxed text-white/65">{balicky.popis}</p>
    </div>
    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        balicky.polozky.map((balik) => (
          <article class="reference-card flex min-h-64 flex-col justify-between overflow-hidden p-7">
            <p class="font-heading text-5xl font-bold text-brand">{balik.suma}</p>
            <img src={balik.obrazok} alt={balik.alt} loading="lazy" class="mt-8 max-h-44 w-full object-contain object-bottom" />
          </article>
        ))
      }
    </div>
  </div>
</section>
