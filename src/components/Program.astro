---
import { balicky, urovne, vyhody } from '../data/content';

const benefitIcons = [
  'M20 12v9H4v-9m16-5H4v5h16V7ZM12 21V7m0 0H8.5A2.5 2.5 0 1 1 11 4.5V7Zm0 0h3.5A2.5 2.5 0 1 0 13 4.5V7Z',
  'M20 7h-5V2m5 5-3.2-3.2A8 8 0 0 0 4.6 6M4 17h5v5m-5-5 3.2 3.2A8 8 0 0 0 19.4 18',
  'M4 20h4v-5H4v5Zm6 0h4V9h-4v11Zm6 0h4V4h-4v16Z',
  'M21 12a3 3 0 0 0-3-3V5H6v4a3 3 0 0 0 0 6v4h12v-4a3 3 0 0 0 3-3Zm-8-4v2m0 4v2',
];
---

<section id="vyhody" class="relative overflow-hidden bg-[#080808]">
  <div class="casino-halo casino-halo-left"></div>
  <div class="relative mx-auto max-w-[88rem] px-5 py-24 lg:px-12 lg:py-36">
    <div class="grid items-end gap-8 lg:grid-cols-[1.15fr_0.55fr]">
      <div>
        <p class="section-kicker">Vernostný program</p>
        <h2 class="section-title mt-6">Hraj. Zbieraj.<br /><span>Vyhrávaj.</span></h2>
      </div>
      <p class="max-w-md text-lg leading-relaxed text-white/58 lg:justify-self-end">
        Zaregistruj sa priamo na prevádzke a pri každej návšteve zbieraj body, bonusy aj nové výhody.
      </p>
    </div>

    <div class="mt-20 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        vyhody.polozky.map((polozka, index) => (
          <article class="benefit-card flex min-h-[23rem] flex-col p-7 lg:p-8">
            <div class="flex items-start justify-between gap-5">
              <span class="benefit-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d={benefitIcons[index]} />
                </svg>
              </span>
              <span class="font-heading text-2xl text-brand/50">0{index + 1}</span>
            </div>
            <div class="mt-auto pt-14">
              <h3 class="font-heading text-2xl font-bold uppercase text-white">{polozka.titulok}</h3>
              <p class="mt-4 max-w-sm text-base leading-relaxed text-white/58">{polozka.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="urovne" class="bg-[#050505]">
  <div class="mx-auto grid max-w-[88rem] lg:grid-cols-[0.82fr_1.18fr]">
    <div class="level-photo relative min-h-[34rem] overflow-hidden lg:min-h-full">
      <img src="/images/hero-casino-06.jpg" alt="Čierno-zlatý herný stôl DOXXbet Casino" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-linear-to-t from-black/55 via-transparent to-black/10"></div>
    </div>
    <div class="px-5 py-20 lg:px-16 lg:py-28">
      <p class="section-kicker">Tvoja cesta programom</p>
      <h2 class="mt-5 font-heading text-5xl font-bold uppercase leading-[0.9] text-white md:text-7xl">Stúpaj vyššie.</h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/58">{urovne.popis}</p>
      <div class="mt-14 border-t border-white/12">
      {
        urovne.karty.map((karta, index) => (
          <article class="level-row grid gap-4 border-b border-white/12 py-7 sm:grid-cols-[4rem_9rem_1fr]">
            <span class="font-heading text-xl text-brand/55">0{index + 1}</span>
            <div><h3 class="font-heading text-3xl font-bold uppercase text-white">{karta.nazov}</h3><p class="mt-1 text-sm text-brand">{urovne.kroky[index].podmienka}</p></div>
            <p class="text-sm leading-relaxed text-white/55">{karta.vyhody}</p>
          </article>
        ))
      }
      </div>
    </div>
  </div>
</section>

<section id="bonusy" class="relative overflow-hidden border-y border-white/8 bg-[#0b0b0b]">
  <div class="casino-halo casino-halo-right"></div>
  <div class="relative mx-auto max-w-[88rem] px-5 py-24 lg:px-12 lg:py-36">
    <p class="section-kicker">Welcome bonus</p>
    <div class="mt-6 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <h2 class="section-title max-w-4xl">Vyber si svoj<br /><span>štartovací balík.</span>
      </h2>
      <p class="max-w-sm text-lg leading-relaxed text-white/58">{balicky.popis}</p>
    </div>
    <div class="mt-16 grid items-start gap-5 lg:grid-cols-3">
      {
        balicky.polozky.map((balik, index) => (
          <details class="bonus-card bonus-details group overflow-hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 p-7 [&::-webkit-details-marker]:hidden lg:p-9">
              <div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/38">Balík 0{index + 1}</span>
                <p class="mt-3 whitespace-nowrap font-heading text-5xl font-bold text-brand xl:text-6xl">{balik.suma}</p>
                <span class="mt-3 block text-sm text-white/50">Zobraziť kompletný rozpis</span>
              </div>
              <span class="bonus-toggle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
              </span>
            </summary>
            <div class="border-t border-white/10 px-5 pb-7 pt-3 lg:px-7 lg:pb-8">
              <div class="bonus-table-head grid grid-cols-[2rem_1.2fr_0.8fr] gap-3 py-3">
                <span>#</span><span>Promo tiket</span><span>Extra bonus</span>
              </div>
              <ol>
                {balik.rozpis.map((riadok, rowIndex) => (
                  <li class="bonus-table-row grid grid-cols-[2rem_1.2fr_0.8fr] gap-3 py-3">
                    <span class="text-brand/65">{rowIndex + 1}.</span>
                    <span class="font-medium text-white/78">{riadok.tiket}</span>
                    <span class:list={[riadok.bonus === '—' ? 'text-white/35' : 'text-brand']}>{riadok.bonus}</span>
                  </li>
                ))}
              </ol>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
