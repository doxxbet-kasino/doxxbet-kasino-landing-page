---
import { footer } from '../data/content';
import { site } from '../data/site';
---

<footer id="kontakt" class="border-t border-white/10 bg-black">
  <div class="mx-auto flex max-w-[88rem] flex-col items-start justify-between gap-8 px-5 py-10 sm:flex-row sm:items-center lg:px-12">
    <img
      src={site.logo.src}
      alt={site.logo.alt}
      width={site.logo.width}
      height={site.logo.height}
      loading="lazy"
      class="h-9 w-auto md:h-12"
    />
    <div class="sm:text-right">
      <p class="text-sm text-white/70">Zelená Voda, 916 38 Beckov · Otvorené NONSTOP</p>
      <p class="mt-2 text-xs uppercase tracking-[0.18em] text-white/42">{footer.text}</p>
    </div>
  </div>
</footer>
