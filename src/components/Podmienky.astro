---
import { podmienky } from '../data/content';
---

<section class="bg-ink-soft">
  <div class="mx-auto max-w-4xl px-4 py-16 md:py-24">
    <p class="heading-accent text-center text-2xl font-bold md:text-3xl">{podmienky.akcent}</p>
    <h2 class="mt-2 text-center font-heading text-3xl font-bold italic uppercase text-white md:text-5xl">
      {podmienky.nadpis}
    </h2>

    <div class="mt-12 space-y-3">
      {
        podmienky.polozky.map((polozka) => (
          <details class="group rounded-2xl bg-ink-softer px-6 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-bold text-white [&::-webkit-details-marker]:hidden">
              {polozka.otazka}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-5 w-5 shrink-0 text-brand transition-transform group-open:rotate-180"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="pt-4 text-base leading-relaxed text-white/80">{polozka.odpoved}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Plynulé rozbaľovanie <details> — v prehliadačoch bez podpory
     ::details-content sa položka otvorí okamžite. */
  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      content-visibility 0.35s allow-discrete,
      block-size 0.35s ease;
  }

  details[open]::details-content {
    block-size: auto;
  }
</style>
