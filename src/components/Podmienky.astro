---
import { podmienky } from '../data/content';
---

<section class="border-y border-white/8 bg-[#0a0a0a]">
  <div class="mx-auto max-w-5xl px-5 py-24 md:py-32">
    <p class="section-kicker text-center">{podmienky.akcent}</p>
    <h2 class="mt-5 text-center font-heading text-5xl font-bold uppercase leading-none text-white md:text-7xl">
      {podmienky.nadpis}
    </h2>

    <div class="mt-14 border-t border-white/12">
      {
        podmienky.polozky.map((polozka) => (
          <details class="group border-b border-white/12 px-1 py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-xl font-bold text-white transition hover:text-brand [&::-webkit-details-marker]:hidden">
              {polozka.otazka}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="h-5 w-5 shrink-0 text-brand transition-transform group-open:rotate-180"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="max-w-3xl pt-5 text-base leading-relaxed text-white/58">{polozka.odpoved}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Plynulé rozbaľovanie <details> — v prehliadačoch bez podpory
     ::details-content sa položka otvorí okamžite. */
  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      content-visibility 0.35s allow-discrete,
      block-size 0.35s ease;
  }

  details[open]::details-content {
    block-size: auto;
  }
</style>
