---
import { hero } from '../data/content';
import { site } from '../data/site';
---

<section class="hero-cinematic relative isolate overflow-hidden bg-black">
  <img
    src="/images/hero-gallery-bar.jpg"
    alt=""
    width="1400"
    height="933"
    fetchpriority="high"
    aria-hidden="true"
    class="hero-cinematic-bg absolute inset-0 h-full w-full object-cover"
  />
  <div class="hero-cinematic-overlay absolute inset-0"></div>
  <div class="hero-cinematic-glow" aria-hidden="true"></div>
  <div class="relative mx-auto grid min-h-[50rem] max-w-[88rem] items-center gap-12 px-5 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:px-12 lg:py-12">
    <div class="relative z-10 mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
      <p class="section-kicker mb-6">Aktuálna ponuka · DOXXbet Casino</p>
      <h1 class="font-heading text-7xl font-bold uppercase italic leading-[0.82] tracking-[-0.045em] sm:text-8xl lg:text-[7.2rem] xl:text-[8.2rem]">
        <span class="text-white">{hero.nadpisRiadok1}</span>
        <br />
        <span class="hero-kit-title">{hero.nadpisRiadok2}</span>
      </h1>
      <p class="mx-auto mt-10 max-w-xl text-xl leading-snug text-white/75 md:text-2xl lg:mx-0">
        <strong class="font-bold text-white">{hero.textPred}</strong>{hero.textPo}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4 lg:justify-start">
        <a href="#registracia" class="hero-renta-cta">{hero.cta}</a>
        <a href={site.kontakt.mapaUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">Nájdi nás</a>
      </div>
      <p class="mt-8 text-sm tracking-wide text-white/65">18+ &nbsp; Vstup od 18 rokov. Hraj zodpovedne.</p>
    </div>

    <div class="hero-cinematic-model-wrap relative mx-auto h-[32rem] w-full max-w-[36rem] lg:h-[46rem]" aria-hidden="true">
      <div class="hero-model-glow"></div>
      <img
        src="/images/hero-renta-model.png"
        alt=""
        width="1024"
        height="1536"
        class="hero-cinematic-model"
      />
      <div class="hero-cinematic-stamp">
        <span>Aktuálna ponuka</span>
        <strong>Ročná renta</strong>
      </div>
    </div>
  </div>
</section>
