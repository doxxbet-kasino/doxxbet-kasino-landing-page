---
import { hero } from '../data/content';
import { site } from '../data/site';
---

<section class="hero-renta relative isolate overflow-hidden bg-black">
  <div class="hero-renta-sparkles" aria-hidden="true"></div>
  <div class="relative mx-auto grid min-h-[44rem] max-w-[90rem] items-center px-5 pt-14 lg:grid-cols-[1.03fr_0.97fr] lg:px-12 lg:pt-0">
    <div class="relative z-10 max-w-3xl pb-12 text-center lg:pb-20 lg:pt-20 lg:text-left">
      <p class="mb-5 text-sm font-bold uppercase tracking-[0.24em] text-brand">Aktuálna ponuka</p>
      <h1 class="font-heading text-6xl font-bold uppercase italic leading-[0.82] tracking-[-0.035em] sm:text-7xl md:text-8xl xl:text-[7.4rem]">
        <span class="text-white">{hero.nadpisRiadok1}</span>
        <br />
        <span class="hero-renta-title">{hero.nadpisRiadok2}</span>
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-xl leading-snug text-white/85 md:text-2xl lg:mx-0">
        <strong class="font-bold text-white">{hero.textPred}</strong>{hero.textPo}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4 lg:justify-start">
        <a href="#registracia" class="hero-renta-cta">{hero.cta}</a>
        <a href={site.kontakt.mapaUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">Nájdite nás</a>
      </div>
      <p class="mt-8 text-sm tracking-wide text-white/65">18+ &nbsp; Vstup od 18 rokov. Hrajte zodpovedne.</p>
    </div>

    <div class="relative z-0 mx-auto flex h-[29rem] w-full max-w-[34rem] items-end justify-center self-end sm:h-[36rem] lg:h-[44rem]">
      <div class="hero-renta-halo" aria-hidden="true"></div>
      <img
        src="/images/hero-model.webp"
        alt="Členka DOXXbet Casino s hráčskymi kartami"
        width="469"
        height="681"
        fetchpriority="high"
        class="relative z-10 h-full w-auto max-w-none object-contain object-bottom drop-shadow-[0_0_45px_rgba(218,180,79,0.22)]"
      />
    </div>
  </div>
</section>
