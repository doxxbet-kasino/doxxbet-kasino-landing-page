---
import { urovne } from '../data/content';

/* Vzhľad číslic, kruhov a štítkov podmienok podľa úrovní (Black → Diamond) */
const styl = [
  {
    cislica: 'text-[#b1bacc]',
    kruh: 'border-[#565656] bg-[#383838]',
    stitok: 'border-[#b1bacc] text-white',
  },
  {
    cislica: 'text-[#e7efff]',
    kruh: 'border-[#b1bacc] bg-[#383838]',
    stitok: 'border-[#b1bacc] text-white',
  },
  {
    cislica: 'text-[#ccb16a]',
    kruh: 'border-[#ccb16a] bg-transparent',
    stitok: 'border-[#ccb16a] text-[#ccb16a]',
  },
  {
    cislica: 'text-brand',
    kruh: 'border-brand bg-transparent',
    stitok: 'border-brand text-brand',
  },
];
---

<section id="urovne" class="border-y border-white/8 bg-[#0d0e1a]">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <h2 class="font-heading text-4xl font-bold italic uppercase text-white md:text-6xl">
      {urovne.nadpisPred}{' '}
      <span class="heading-accent normal-case">{urovne.nadpisAkcent}</span>
    </h2>
    <p class="mt-6 max-w-xl text-lg text-white/70">{urovne.popis}</p>

    <div class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        urovne.karty.map((karta, i) => (
          <div class="flex flex-col items-center gap-8">
            <div
              class:list={[
                'flex h-16 w-16 items-center justify-center rounded-full border-2',
                styl[i].kruh,
              ]}
            >
              <span class:list={['font-accent text-3xl font-bold', styl[i].cislica]}>
                {urovne.kroky[i].rimske}
              </span>
            </div>

            <div class="w-full flex-1 rounded-2xl bg-ink-softer p-6">
              <h3 class="font-accent text-3xl font-bold italic text-white">{karta.nazov}</h3>
              <p
                class:list={[
                  'mt-3 inline-block rounded-md border bg-[#1d1d1d] px-3 py-1.5 text-xs',
                  styl[i].stitok,
                ]}
              >
                {urovne.kroky[i].podmienka}
              </p>
              <p class="mt-6 text-sm leading-relaxed text-white">
                <b>Občerstvenie zdarma</b>
                <br />
                {karta.obcerstvenie}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-white">
                <b>Výhody</b>
                <br />
                {karta.vyhody}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
