---
import { prvykrat } from '../data/content';
---

<section class="relative overflow-hidden border-y border-white/8">
  <img
    src="/images/prvykrat-bg.webp"
    alt=""
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-[rgba(10,11,22,0.76)]"></div>

  <div class="relative mx-auto grid max-w-7xl items-end gap-x-10 px-4 md:grid-cols-2 lg:px-6">
    <div class="pb-16 pt-32 md:pb-24 md:pt-48">
      <h2 class="font-heading text-3xl font-bold italic uppercase text-white md:text-5xl">
        {prvykrat.akcent}
      </h2>
      <p class="heading-accent mt-2 text-4xl font-bold md:text-6xl">{prvykrat.nadpis}</p>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-white">{prvykrat.text}</p>
    </div>
    <!-- foto sedí na spodnom okraji sekcie -->
    <div class="flex justify-center self-end md:justify-end">
      <img
        src="/images/prvykrat-foto.webp"
        alt="Personál DOXXbet Casino"
        width="650"
        height="566"
        loading="lazy"
        class="block w-full max-w-lg"
      />
    </div>
  </div>
</section>
