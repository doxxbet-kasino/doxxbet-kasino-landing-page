---
import { vyhody } from '../data/content';
---

<section id="vyhody" class="border-y border-white/8 bg-[#0d0e1a]">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.22em] text-brand">Vernostný program</p>
      <h2 class="mt-4 font-heading text-4xl font-bold italic uppercase leading-none text-white md:text-6xl">
      {vyhody.nadpisPred}{' '}
      <span class="heading-accent normal-case">{vyhody.nadpisAkcent}</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-3">
      {
        vyhody.polozky.map((polozka) => (
          <div class="bg-[#141522] p-8">
            <img src={polozka.ikona} alt="" width="21" height="21" class="h-6 w-6" />
            <h3 class="mt-5 font-heading text-2xl font-bold italic text-brand">{polozka.titulok}</h3>
            <p class="mt-4 text-base leading-relaxed text-white/70">{polozka.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a href="#registracia" class="btn-gold">{vyhody.cta}</a>
    </div>
  </div>
</section>
