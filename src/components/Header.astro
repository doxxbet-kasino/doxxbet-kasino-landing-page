---
import { site } from '../data/site';
---

<header class="relative z-20 border-b border-white/8 bg-[#0a0b16]">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-4 py-4 lg:px-6">
    <a href="/">
      <img
        src={site.logo.src}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
        class="h-9 w-auto md:h-11"
      />
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-white/75 lg:flex" aria-label="Hlavná navigácia">
      <a href="#vyhody" class="transition hover:text-brand">Výhody</a>
      <a href="#registracia" class="transition hover:text-brand">Registrácia</a>
      <a href="#urovne" class="transition hover:text-brand">Úrovne</a>
      <a href="#kontakt" class="transition hover:text-brand">Kontakt</a>
    </nav>
    <a href="#registracia" class="hidden rounded-full bg-linear-to-r from-brand-dark to-brand px-5 py-2.5 text-sm font-bold text-white transition hover:brightness-110 sm:inline-flex">
      Získať hráčsku kartu
    </a>
  </div>
</header>
