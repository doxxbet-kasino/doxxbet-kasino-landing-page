---
import { site } from '../data/site';
---

<header class="relative z-20 border-b border-white/8 bg-[#070707]">
  <div class="mx-auto flex max-w-[88rem] items-center justify-between gap-5 px-5 py-5 lg:px-12">
    <a href="/">
      <img
        src={site.logo.src}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
        class="h-10 w-auto md:h-12"
      />
    </a>
    <nav class="hidden items-center gap-10 text-base font-medium text-white/70 lg:flex" aria-label="Hlavná navigácia">
      <a href="#vyhody" class="transition hover:text-brand">Výhody</a>
      <a href="#urovne" class="transition hover:text-brand">Úrovne</a>
      <a href="#bonusy" class="transition hover:text-brand">Bonusy</a>
      <a href="#registracia" class="transition hover:text-brand">Registrácia</a>
    </nav>
    <a href="#registracia" class="btn-gold hidden sm:inline-flex">
      Získať kartu
    </a>
  </div>
</header>
