---
import { site } from '../data/site';
---

<section class="final-cta relative isolate overflow-hidden bg-black">
  <img src="/images/hero-gallery-bar.jpg" alt="Interiér DOXXbet Casina Zelená Voda" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-black/78"></div>
  <div class="absolute inset-0 bg-linear-to-r from-black via-black/65 to-transparent"></div>
  <div class="relative mx-auto flex min-h-[40rem] max-w-[88rem] flex-col justify-center px-5 py-24 lg:px-12">
    <p class="section-kicker">Tvoja ďalšia výhra sa začína tu</p>
    <h2 class="mt-6 max-w-5xl font-heading text-6xl font-bold uppercase leading-[0.86] text-white md:text-8xl lg:text-[7.5rem]">
      Príď hrať.<br /><span class="text-brand">Zostaň vyhrávať.</span>
    </h2>
    <a href={site.kontakt.mapaUrl} target="_blank" rel="noopener noreferrer" class="btn-gold mt-10 self-start">Nájsť kasíno</a>
  </div>
</section>
