---
import { kontakt } from '../data/content';
import { site } from '../data/site';

const udaje = [
  { popisok: 'Adresa', hodnota: site.kontakt.adresa },
  {
    popisok: 'Telefón',
    hodnota: site.kontakt.telefony[0],
    href: `tel:${site.kontakt.telefony[0].replaceAll(' ', '')}`,
  },
  { popisok: 'Email', hodnota: site.kontakt.email, href: `mailto:${site.kontakt.email}` },
  { popisok: 'Otváracie hodiny', hodnota: site.kontakt.otvaracieHodiny },
];
---

<section id="kontakt" class="bg-[linear-gradient(180deg,rgba(209,172,55,0.5),#ffffff)]">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <h2 class="text-center font-heading text-3xl font-bold italic uppercase text-ink-softer md:text-5xl">
      {kontakt.nadpisPred}
      <span class="heading-accent normal-case">{kontakt.nadpisAkcent}</span>
    </h2>
    <p class="mt-6 text-center text-lg text-ink">{kontakt.text}</p>

    <div class="mt-14 grid items-center gap-10 md:grid-cols-2">
      <div>
        <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            udaje.map((udaj) => (
              <div>
                <dt class="font-heading text-lg font-bold italic uppercase text-brand-light">
                  {udaj.popisok}
                </dt>
                <dd class="mt-1 text-lg font-light text-[#1b1b1b]">
                  {udaj.href ? (
                    <a href={udaj.href} class="hover:text-brand-dark">
                      {udaj.hodnota}
                    </a>
                  ) : (
                    udaj.hodnota
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <a
          href={site.kontakt.mapaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold mt-10"
        >
          {kontakt.ctaMapa}
        </a>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/images/kontakt-foto.webp"
          alt="Interiér DOXXbet Casino Zelená Voda"
          width="673"
          height="550"
          loading="lazy"
          class="w-full max-w-lg rounded-2xl"
        />
      </div>
    </div>
  </div>
</section>
