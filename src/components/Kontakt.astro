---
import { kontakt } from '../data/content';
import { site } from '../data/site';

const udaje = [
  { popisok: 'Adresa', hodnota: site.kontakt.adresa },
  {
    popisok: 'Telefón',
    hodnota: site.kontakt.telefony[0],
    href: `tel:${site.kontakt.telefony[0].replaceAll(' ', '')}`,
  },
  { popisok: 'Email', hodnota: site.kontakt.email, href: `mailto:${site.kontakt.email}` },
  { popisok: 'Otváracie hodiny', hodnota: site.kontakt.otvaracieHodiny },
];
---

<section id="kontakt" class="bg-[#0a0b16]">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <h2 class="max-w-2xl font-heading text-4xl font-bold italic uppercase leading-none text-white md:text-6xl">
      {kontakt.nadpisPred}{' '}
      <span class="heading-accent normal-case">{kontakt.nadpisAkcent}</span>
    </h2>
    <p class="mt-6 max-w-xl text-lg text-white/70">{kontakt.text}</p>

    <div class="mt-14 grid items-center gap-10 lg:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-[#141522] p-8 md:p-10">
        <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            udaje.map((udaj) => (
              <div>
                <dt class="font-heading text-lg font-bold italic uppercase text-brand-light">
                  {udaj.popisok}
                </dt>
                <dd class="mt-1 text-lg font-light text-white/80">
                  {udaj.href ? (
                    <a href={udaj.href} class="hover:text-brand-dark">
                      {udaj.hodnota}
                    </a>
                  ) : (
                    udaj.hodnota
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <a
          href={site.kontakt.mapaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold mt-10"
        >
          {kontakt.ctaMapa}
        </a>
      </div>

      <div class="relative overflow-hidden rounded-2xl">
        <img
          src="/images/kontakt-foto.webp"
          alt="Interiér DOXXbet Casino Zelená Voda"
          width="673"
          height="550"
          loading="lazy"
          class="h-full min-h-[22rem] w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
