---
import { registracia } from '../data/content';
---

<section id="registracia" class="bg-[#0a0b16]">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 lg:grid-cols-[1fr_0.9fr] lg:px-6 lg:py-32">
    <div>
      <p class="font-heading text-lg font-bold italic uppercase tracking-wide text-brand">
        Vernostný program DOXXbet Casino
      </p>
      <h2 class="mt-4 max-w-xl font-heading text-4xl font-bold italic uppercase leading-none text-white md:text-6xl">
        {registracia.nadpisPred}{' '}
        <span class="heading-accent normal-case">{registracia.nadpisAkcent}</span>
      </h2>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/70">{registracia.popis}</p>
      <p class="mt-12 font-accent text-6xl font-bold italic text-brand/40 md:text-8xl">NONSTOP</p>
    </div>

    <ol class="grid overflow-hidden rounded-2xl border border-white/10 bg-white/5">
      {
        registracia.kroky.map((krok) => (
          <li class="flex gap-5 border-b border-white/10 p-7 last:border-b-0">
            <span class="font-accent text-4xl font-bold italic text-brand">{krok.cislo}</span>
            <div><h3 class="font-heading text-2xl font-bold italic text-white">{krok.titulok}</h3><p class="mt-2 leading-relaxed text-white/65">{krok.text}</p></div>
          </li>
        ))
      }
    </ol>

    <div class="lg:col-span-2 -mt-4 text-center lg:mt-0">
      <a href="#kontakt" class="btn-gold">{registracia.cta}</a>
    </div>
  </div>
</section>
