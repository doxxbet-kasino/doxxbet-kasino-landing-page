---
import { registracia } from '../data/content';
import { site } from '../data/site';
---

<section id="registracia" class="bg-[#050505]">
  <div class="mx-auto grid max-w-[88rem] lg:grid-cols-[1fr_1fr]">
    <div class="px-5 py-24 lg:px-12 lg:py-32">
      <p class="section-kicker">Registrácia na prevádzke</p>
      <h2 class="mt-6 max-w-2xl font-heading text-5xl font-bold uppercase leading-[0.9] text-white md:text-7xl">
        {registracia.nadpisPred}{' '}
        <span class="text-brand">{registracia.nadpisAkcent}</span>
      </h2>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/58">{registracia.popis}</p>
      <div class="mt-14 grid max-w-2xl gap-px overflow-hidden border border-white/12 bg-white/12 sm:grid-cols-2">
        <div class="bg-[#0b0b0b] p-6"><p class="info-label">Kde nás nájdeš</p><p class="mt-2 text-white/68">{site.kontakt.adresa}</p></div>
        <div class="bg-[#0b0b0b] p-6"><p class="info-label">Otváracie hodiny</p><p class="mt-2 text-white/68">{site.kontakt.otvaracieHodiny}</p></div>
        <div class="bg-[#0b0b0b] p-6"><p class="info-label">Telefonický kontakt</p><a class="mt-2 block text-white/68 hover:text-brand" href={`tel:${site.kontakt.telefony[0].replaceAll(' ', '')}`}>{site.kontakt.telefony[0]}</a></div>
        <div class="bg-[#0b0b0b] p-6"><p class="info-label">Welcome bonus</p><p class="mt-2 text-white/68">Až 1 000 €</p></div>
      </div>
    </div>

    <div class="registration-panel relative overflow-hidden px-5 py-24 lg:px-12 lg:py-32">
      <div class="absolute inset-0"><img src="/images/hero-gallery-logo.jpg" alt="Interiér DOXXbet Casina Zelená Voda" loading="lazy" class="h-full w-full object-cover" /><div class="absolute inset-0 bg-black/78 backdrop-blur-[1px]"></div></div>
      <div class="relative mx-auto max-w-xl">
      <p class="section-kicker">Tri jednoduché kroky</p>
      <h3 class="mt-5 font-heading text-5xl font-bold uppercase leading-[0.9] text-white">Začni hrať<br /><span class="text-brand">s výhodami.</span></h3>
      <ol class="mt-12 border-t border-white/18">
      {
        registracia.kroky.map((krok) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-5 border-b border-white/18 py-6">
            <span class="font-heading text-xl text-brand">{krok.cislo}</span>
            <div><h4 class="font-heading text-2xl font-bold uppercase text-white">{krok.titulok}</h4><p class="mt-2 leading-relaxed text-white/65">{krok.text}</p></div>
          </li>
        ))
      }
      </ol>
      <a href={site.kontakt.mapaUrl} target="_blank" rel="noopener noreferrer" class="btn-gold mt-8 w-full">{registracia.cta}</a>
      </div>
    </div>
  </div>
</section>
