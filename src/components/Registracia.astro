---
import { registracia } from '../data/content';
---

<section id="registracia" class="bg-ink-soft">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-heading text-lg font-bold italic uppercase tracking-wide text-brand">
        Vernostný program DOXXbet Casino
      </p>
      <h2 class="mt-3 font-heading text-3xl font-bold italic uppercase text-white md:text-5xl">
        {registracia.nadpisPred}{' '}
        <span class="heading-accent normal-case">{registracia.nadpisAkcent}</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-white/90">{registracia.popis}</p>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-3 md:gap-8">
      {
        registracia.kroky.map((krok) => (
          <li class="rounded-2xl border border-brand/35 bg-ink-softer p-7">
            <span class="font-accent text-4xl font-bold italic text-brand">{krok.cislo}</span>
            <h3 class="mt-5 font-heading text-2xl font-bold italic text-white">{krok.titulok}</h3>
            <p class="mt-3 leading-relaxed text-white/80">{krok.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 text-center">
      <a href="#kontakt" class="btn-gold">{registracia.cta}</a>
    </div>
  </div>
</section>
